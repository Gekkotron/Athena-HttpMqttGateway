# NOTE: systemd's EnvironmentFile= parser does NOT strip inline `# comment`
# fragments from values, so keep comments on their OWN lines above each var.
# The Python helpers strip inline comments defensively, but treat this as
# insurance, not licence.

# =========================================================================
# Security
# =========================================================================
MAX_AGE_SECONDS=60

# Absolute or relative path to the secret-key file. If unset, the gateway
# health check auto-detects `data/secret_key.txt` (Docker bind-mount layout)
# then `server/secret_key.txt` (plain-Python dev layout). Only set this
# explicitly if the key lives somewhere else.
# SECRET_KEY_FILE=data/secret_key.txt
#
# The file is a line-based list of secrets, each `<64-hex-chars>[:<scope>]`:
#   <hex>:*                # full access to every service
#   <hex>:80               # only /gateway (HTTP forwarding)
#   <hex>:80,1883          # /gateway + /mqtt/publish + /mqtt/subscribe
#   <hex>                  # bare hex (no scope) is treated as `*` (legacy)
# Blank lines and `#` comments are ignored. Ports map to endpoint families,
# not target URL ports: 80 = /gateway, 1883 = /mqtt/*.
# On startup, if the file is missing, one wildcard secret is generated
# automatically and written as `<hex>:*`.
# Requests with a secret that no key matches receive an unencrypted HTTP 401.


# =========================================================================
# Health check - HTTP gateway (test_client/health_check.py --gateway)
# =========================================================================
# URL used for the encrypted round-trip probe.
# HEALTH_CHECK_URL=https://httpbin.org/get
# Per-request timeout in seconds.
# HEALTH_TIMEOUT=10


# =========================================================================
# Health check - Tailscale funnel (test_client/health_check.py --tailscale)
# =========================================================================
# Public funnel URL - required for the remote HTTPS probe.
# TAILSCALE_FUNNEL_URL=https://your-host.tail-scale.ts.net
# Expected port bound to the funnel.
# TAILSCALE_FUNNEL_PORT=10000
# tailscale CLI binary path.
# TAILSCALE_BIN=tailscale
# auto | true | false -- skip local `tailscale status` / `funnel status`
# checks when the CLI is missing (auto), always on (true), or always off
# (false, remote probe only).
# TAILSCALE_CHECK_LOCAL=auto


# =========================================================================
# --restart behaviour (test_client/health_check.py --restart)
# =========================================================================
# Command that bounces the HTTP gateway.
# GATEWAY_RESTART_CMD=docker compose restart gateway
# Command that re-arms the Tailscale funnel (script uses sudo internally).
# TAILSCALE_RESTART_CMD=./run_tailscale.sh

# Exponential backoff for the post-restart re-check loop.
# Defaults give delays of 2s, 4s, 8s, 16s, 32s -- up to ~62s total wait.
# RESTART_BACKOFF_INITIAL=2
# RESTART_BACKOFF_FACTOR=2
# 0 = retry forever until PASS.
# RESTART_BACKOFF_MAX_ATTEMPTS=5
# Per-attempt delay cap in seconds; plateau in infinite mode.
# RESTART_BACKOFF_MAX_DELAY=300


# =========================================================================
# MQTT failure alerts
# =========================================================================
# Published when a health check ends in a non-zero state (recovered runs
# stay silent). Alerts are auto-enabled when MQTT_BROKER_HOST is set.

# Broker host - required; leave unset to disable alerts entirely.
# MQTT_BROKER_HOST=192.168.1.91
# MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# auto | true | false -- 'auto' enables when MQTT_BROKER_HOST is set.
# HEALTH_ALERT_ENABLED=auto

# State-topic semantics: publish current status (ok/fail/config_error) after
# EVERY run so subscribers always know if the component is healthy. Retain is
# on by default so a subscriber connecting between runs sees the last state.
# Set to false to fall back to failure-only event semantics (in which case
# also set HEALTH_ALERT_MQTT_RETAIN=false).
# HEALTH_ALERT_PUBLISH_ON_SUCCESS=true

# HEALTH_ALERT_MQTT_TOPIC_PREFIX=encryption-gateway/health
# HEALTH_ALERT_MQTT_QOS=1
# HEALTH_ALERT_MQTT_RETAIN=true
# HEALTH_ALERT_MQTT_TIMEOUT=5
